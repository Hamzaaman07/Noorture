---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import NoortureMark from '../components/NoortureMark.astro';
import Button from '../components/Button.astro';
import ProvisionalNote from '../components/ProvisionalNote.astro';
import { ABOUT_WHAT_IS_NOORTURE, ABOUT_HODA } from '../data/approved-copy';
import { SOCIAL, CREDENTIALS, CTA } from '../consts';

const title = 'About';
const description =
  'What Noorture means, and about Hoda Shawky — pediatric nurse practitioner, IBCLC lactation consultant, and founder of Noorture.';
---

<BaseLayout title={title} description={description}>
  {/*
    §4.6: this is the one page where a visitor has already decided to spend
    time. It can be slow and beautiful — hence the full lockup, the wide
    measure, and the unhurried rhythm.
  */}
  <Section narrow>
    <div class="lede">
      <NoortureMark variant="stacked" alt="Noorture" class="lede__mark" />
      <p class="lede__sub">
        <em>Noor</em> means light. The name is the whole idea: not only to
        nurture a child, but to noorture — to raise them, and yourself, in it.
      </p>
    </div>
  </Section>

  <Section tint narrow labelledby="what-is">
    <div class="prose">
      <h1 id="what-is">What is Noorture</h1>
      {
        ABOUT_WHAT_IS_NOORTURE ? (
          <div class="prose__approved" set:html={ABOUT_WHAT_IS_NOORTURE} />
        ) : (
          <ProvisionalNote pending="the client supplying the full approved passage">
            <p>
              §4.6 calls for the existing passage beginning{' '}
              <em>“As much as we want to pour love into our little ones…”</em>,
              used verbatim. The build spec quotes only that opening fragment,
              and client-approved copy must not be paraphrased or reconstructed
              — so the passage is not shown rather than shown wrongly.
            </p>
            <p>
              Paste it into <code>ABOUT_WHAT_IS_NOORTURE</code> in{' '}
              <code>src/data/approved-copy.ts</code> and this section renders it
              and drops this note.
            </p>
          </ProvisionalNote>
        )
      }
    </div>
  </Section>

  <Section narrow labelledby="about-hoda">
    <div class="prose">
      <h2 id="about-hoda">About Hoda</h2>

      <div class="bio">
        <div class="bio__portrait">
          {/* §4.6 asks for a photo. None has been supplied; a stock portrait
              standing in for a real clinician would be worse than an honest
              gap. */}
          <div class="bio__placeholder">
            <span>Photograph<br />to come</span>
          </div>
        </div>

        <div class="bio__body">
          <p class="bio__name">Hoda Shawky</p>
          <p class="bio__creds">RN, MSN, CPNP, IBCLC, PMHS</p>
          <ul class="bio__list">
            {CREDENTIALS.map((c) => <li>{c}</li>)}
          </ul>
          <p class="bio__links">
            <a href={SOCIAL.instagram} rel="me noopener" target="_blank">Instagram</a>
            <a href={SOCIAL.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
          </p>
        </div>
      </div>

      {
        ABOUT_HODA ? (
          <div class="prose__approved" set:html={ABOUT_HODA} />
        ) : (
          <ProvisionalNote pending="the client supplying the full approved bio and a photo">
            <p>
              §4.6 calls for the full existing bio, used verbatim, with a photo.
              Neither is in the build spec. Inventing a biography for a licensed
              clinician would be worse than leaving the gap visible, so the
              credentials above are shown and the bio is not.
            </p>
            <p>
              Paste it into <code>ABOUT_HODA</code> in{' '}
              <code>src/data/approved-copy.ts</code>, and drop the portrait at{' '}
              <code>src/assets/hoda.jpg</code>.
            </p>
          </ProvisionalNote>
        )
      }
    </div>
  </Section>

  <Section tint narrow>
    <div class="tail">
      <h2>Start with a conversation</h2>
      <p>
        Fifteen minutes, free, and no obligation to book anything afterwards.
      </p>
      <p class="tail__cta"><Button href={CTA.primaryHref}>{CTA.primaryLabel}</Button></p>
    </div>
  </Section>
</BaseLayout>

<style>
  .lede {
    text-align: center;
  }

  .lede :global(.lede__mark) {
    margin-inline: auto;
    width: 15rem;
  }

  .lede__sub {
    margin: 2rem auto 0;
    max-width: 32rem;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.45;
    color: var(--color-noor-ink);
  }

  .prose h1,
  .prose h2 {
    margin: 0 0 1.25rem;
    font-size: var(--text-3xl);
  }

  .prose__approved :global(p) {
    margin: 0 0 1.1rem;
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .bio {
    display: grid;
    gap: 1.75rem;
    margin-bottom: 2rem;
  }

  .bio__placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    border-radius: 1.25rem;
    border: 1px dashed var(--color-noor-aqua-deep);
    background:
      radial-gradient(
        90% 120% at 20% 0%,
        color-mix(in srgb, var(--color-noor-rose) 16%, transparent),
        transparent 62%
      ),
      color-mix(in srgb, var(--color-noor-bg-alt) 60%, transparent);
    color: var(--color-noor-ink-soft);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
  }

  .bio__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }

  .bio__creds {
    margin: 0.3rem 0 1.1rem;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-noor-ink-soft);
  }

  .bio__list {
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .bio__list li {
    position: relative;
    padding-left: 1.5rem;
    font-size: var(--text-sm);
  }
  .bio__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--color-noor-rose-deep);
  }

  .bio__links {
    margin: 0;
    display: flex;
    gap: 1.25rem;
  }
  .bio__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-noor-aqua-ink);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    border-bottom: 1px solid var(--color-noor-aqua);
  }

  .prose :global(code) {
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border-radius: 0.3rem;
    background: color-mix(in srgb, var(--color-noor-aqua) 18%, transparent);
  }

  .tail {
    text-align: center;
  }
  .tail h2 {
    margin: 0;
    font-size: var(--text-2xl);
  }
  .tail p {
    margin: 0.9rem auto 0;
    max-width: 30rem;
    font-size: var(--text-sm);
    color: var(--color-noor-ink-soft);
  }
  .tail__cta {
    margin-top: 1.75rem;
  }

  @media (min-width: 40rem) {
    .bio {
      grid-template-columns: 15rem 1fr;
      align-items: start;
      gap: 2.5rem;
    }
  }
</style>
