---
/**
 * One of the three products (§4.1). Equal weight, each linking to its own page.
 */
interface Props {
  title: string;
  href: string;
  cta: string;
  accent?: 'rose' | 'aqua';
}
const { title, href, cta, accent = 'aqua' } = Astro.props;
---

<article class:list={['card', `card--${accent}`]}>
  <h3 class="card__title">
    <!-- The whole card is the target; the link inside keeps it one tab stop
         and one accessible name. -->
    <a href={href} class="card__link">{title}</a>
  </h3>
  <div class="card__body"><slot /></div>
  <p class="card__cta" aria-hidden="true">{cta} <span>&rarr;</span></p>
</article>

<style>
  /*
    Flat surface, hairline rule, no coloured tab across the top. The tabs and
    the lift-on-hover were doing the work of making three equal things look
    interesting; whitespace and a clear type hierarchy do it without the
    app-tile look.
  */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 4vw, 2.25rem);
    background: var(--color-noor-surface);
    border: 1px solid var(--color-noor-line);
    border-radius: var(--radius-md);
    transition: border-color 200ms var(--ease-noor);
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--color-noor-ink-soft);
  }

  .card__title {
    margin: 0;
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
  }

  .card__link {
    color: var(--color-noor-ink);
    text-decoration: none;
  }
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card__body {
    margin-top: 0.75rem;
    flex: 1;
  }
  .card__body :global(p) {
    margin: 0;
    color: var(--color-noor-ink-soft);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .card__cta {
    margin: 1.75rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-noor-line);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-noor-ink);
  }
  .card__cta span {
    display: inline-block;
    transition: transform 220ms var(--ease-noor);
  }
  .card:hover .card__cta span {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card__cta span {
      transition: none;
    }
    .card:hover .card__cta span {
      transform: none;
    }
  }
</style>
