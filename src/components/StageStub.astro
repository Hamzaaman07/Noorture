---
/**
 * Provisional page body. Stage 1 builds the shell and the hero; the nav
 * still has to work at 360px on a real phone during review, so every route
 * resolves to this rather than a 404.
 *
 * Each of these is replaced by its real page in Stage 2 or 3.
 */
interface Props {
  title: string;
  stage: string;
  note: string;
}
const { title, stage, note } = Astro.props;
---

<section class="stub">
  <p class="stub__flag">In progress — {stage}</p>
  <h1>{title}</h1>
  <p class="stub__note">{note}</p>
  <p class="stub__back"><a href="/" class="tap">&larr; Back to home</a></p>
</section>

<style>
  .stub {
    max-width: 40rem;
    margin: 0 auto;
    padding: clamp(3rem, 9vw, 6rem) clamp(1rem, 4vw, 2.5rem);
    text-align: center;
  }

  .stub__flag {
    display: inline-block;
    margin: 0 0 1.25rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-noor-line-alt);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-noor-bg-alt) 80%, transparent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-noor-ink-soft);
  }

  h1 {
    margin: 0;
    font-size: var(--text-3xl);
  }

  .stub__note {
    margin: 1.1rem auto 0;
    max-width: 32rem;
    color: var(--color-noor-ink-soft);
  }

  .stub__back {
    margin-top: 2rem;
  }
  .stub__back a {
    color: var(--color-noor-aqua-ink);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--color-noor-aqua);
    padding-bottom: 2px;
  }
</style>
