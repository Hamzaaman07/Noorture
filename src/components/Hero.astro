---
import { Image } from 'astro:assets';
import lockup from '../assets/noorture-lockup.png';
import Button from './Button.astro';
import { CTA, CREDENTIALS } from '../consts';
---

<section class="hero">
  <div class="hero__inner">
    <!--
      The logo is the hero.

      §4.1 originally led with the descriptive headline, on the reasoning that
      "Noorture" is a coined word and the old site spent three paragraphs
      decoding it before saying what was for sale. That reasoning still holds,
      so the tagline sits immediately under the mark at a size you cannot miss —
      the brand leads, and the sentence that explains it is the very next thing
      the eye lands on.

      Sizing note: the supplied artwork is a 408px print file, so the lockup is
      392px wide. It is capped below ~360px on purpose — pushed larger it goes
      soft on the phones this audience actually uses. Vector artwork would lift
      that cap; see README.
    -->
    <h1 class="hero__mark">
      <Image
        src={lockup}
        alt="Noorture"
        widths={[196, 392]}
        sizes="(min-width: 48rem) 360px, 280px"
        loading="eager"
        fetchpriority="high"
      />
    </h1>

    <p class="hero__tagline">
      Islamic-rooted support for the{' '}
      <span class="hero__accent">early years of parenting.</span>
    </p>

    <p class="hero__subhead">
      Consultations, private classes, and support circles from a pediatric
      nurse practitioner and lactation consultant.
    </p>

    <div class="hero__actions">
      <!-- The free 15-minute call is the lowest-friction entry point in the
           entire price list, so it sits above the fold. -->
      <Button href={CTA.primaryHref}>{CTA.primaryLabel}</Button>
      <Button href={CTA.secondaryHref} variant="secondary">
        {CTA.secondaryLabel}
      </Button>
    </div>

    <p class="hero__credentials">
      {
        CREDENTIALS.map((item, i) => (
          <>
            {i > 0 && <span class="dot" aria-hidden="true">·</span>}
            <span>{item}</span>
          </>
        ))
      }
    </p>
  </div>
</section>

<style>
  .hero {
    padding: clamp(2rem, 6vw, 4rem) clamp(1rem, 4vw, 2.5rem)
      clamp(3.5rem, 10vw, 6rem);
    min-height: min(88svh, 50rem);
    display: flex;
    align-items: center;
  }

  .hero__inner {
    max-width: 46rem;
    margin: 0 auto;
    text-align: center;
  }

  .hero__mark {
    margin: 0 auto;
    /* h1 carries the mark, so it must not inherit the display-serif metrics. */
    line-height: 0;
  }

  .hero__mark :global(img) {
    width: 17.5rem;
    height: auto;
    margin-inline: auto;
  }

  .hero__tagline {
    margin: clamp(1.5rem, 4vw, 2.25rem) auto 0;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .hero__accent {
    color: var(--color-noor-aqua-ink);
    font-style: italic;
  }

  .hero__subhead {
    margin: clamp(0.9rem, 2.5vw, 1.25rem) auto 0;
    max-width: 34rem;
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--color-noor-ink-soft);
  }

  .hero__actions {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero__credentials {
    margin: clamp(1.75rem, 4vw, 2.5rem) auto 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.3rem 0.65rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-noor-ink-soft);
  }

  .dot {
    color: var(--color-noor-rose-deep);
  }

  @media (min-width: 34rem) {
    .hero__actions {
      flex-direction: row;
      justify-content: center;
    }
  }

  @media (min-width: 48rem) {
    .hero__mark :global(img) {
      width: 22.5rem;
    }
    .hero__subhead {
      font-size: var(--text-lg);
    }
  }
</style>
