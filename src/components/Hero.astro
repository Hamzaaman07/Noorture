---
import NoortureMark from './NoortureMark.astro';
import Button from './Button.astro';
import { CTA, CREDENTIALS } from '../consts';
import { HERO_SUBHEAD } from '../data/approved-copy';
---

<section class="hero">
  <div class="hero__inner">
    {/*
      The wordmark IS the hero.

      It can be this large because it is vector — traced from the
      high-resolution artwork by `npm run build:wordmark`. The print file it
      replaced is 392px wide and would have been roughly four times too small
      for this.
    */}
    <h1 class="hero__word">
      <NoortureMark variant="wordmark" alt="Noorture" />
    </h1>

    {/* CLIENT-APPROVED, VERBATIM (§4.1). See approved-copy.json. */}
    <p class="hero__subhead">{HERO_SUBHEAD}</p>

    <div class="hero__actions">
      {/* The free 15-minute call is the lowest-friction entry point in the
          entire price list, so it sits above the fold. */}
      <Button href={CTA.primaryHref}>{CTA.primaryLabel}</Button>
      <Button href={CTA.secondaryHref} variant="secondary">
        {CTA.secondaryLabel}
      </Button>
    </div>

    <p class="hero__credentials">
      {
        /* No separator glyph any more — each credential ends in its own full
           stop, so a middot between them would be punctuation twice. */
        CREDENTIALS.map((item) => <span>{item}</span>)
      }
    </p>
  </div>
</section>

<style>
  .hero {
    padding: clamp(2.5rem, 8vw, 5rem) clamp(1rem, 4vw, 2.5rem)
      clamp(3.5rem, 9vw, 6rem);
    min-height: min(90svh, 52rem);
    display: flex;
    align-items: center;
  }

  .hero__inner {
    width: 100%;
    max-width: 64rem;
    margin: 0 auto;
    text-align: center;
  }

  .hero__word {
    margin: 0 auto;
    /* An h1 carrying artwork must not inherit display-serif line metrics. */
    line-height: 0;
    /* Fills most of the measure at every width, which is the point. */
    width: min(100%, 60rem);
  }

  .hero__subhead {
    margin: clamp(1.75rem, 4.5vw, 2.75rem) auto 0;
    max-width: 34rem;
    font-size: var(--text-lg);
    line-height: 1.55;
    /* Full ink rather than the softer secondary tone: the hero's ambience is
       deliberately the boldest on the site, and copy sitting on it has to hold
       its own. Verified per element by npm run check:contrast. */
    color: var(--color-noor-ink);
  }

  .hero__actions {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    /* Wide enough that the buttons' soft glows do not merge into each other. */
    gap: 1rem;
  }

  .hero__credentials {
    margin: clamp(1.75rem, 4vw, 2.5rem) auto 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    /* Wider than the old 0.65rem: the middots used to do the separating and
       now the gap has to, or the items read as one run-on line. */
    gap: 0.4rem 1.6rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-noor-ink);
  }

  @media (min-width: 34rem) {
    .hero__actions {
      flex-direction: row;
      justify-content: center;
    }
  }
</style>
