---
import Button from './Button.astro';
import { CTA, CREDENTIALS } from '../consts';
---

<section class="hero">
  <div class="hero__inner">
    <!--
      "Noorture" is a coined word — nobody arrives knowing what it means, so
      the headline says what this is in words a tired mother parses in two
      seconds. The name earns its meaning on /about (spec §4.1).
    -->
    <h1 class="hero__headline">
      Islamic-rooted support for the{' '}
      <span class="hero__accent">early years of parenting.</span>
    </h1>

    <p class="hero__subhead">
      Consultations, private classes, and support circles from a pediatric
      nurse practitioner and lactation consultant.
    </p>

    <div class="hero__actions">
      <!-- The free 15-minute call is the lowest-friction entry point in the
           entire price list, so it sits above the fold. -->
      <Button href={CTA.primaryHref}>{CTA.primaryLabel}</Button>
      <Button href={CTA.secondaryHref} variant="secondary">
        {CTA.secondaryLabel}
      </Button>
    </div>

    <p class="hero__credentials">
      {
        CREDENTIALS.map((item, i) => (
          <>
            {i > 0 && <span class="dot" aria-hidden="true">·</span>}
            <span>{item}</span>
          </>
        ))
      }
    </p>
  </div>
</section>

<style>
  .hero {
    /* Leaves the sticky header's height of hero visible without a jump. */
    padding: clamp(3rem, 9vw, 6.5rem) clamp(1rem, 4vw, 2.5rem)
      clamp(3.5rem, 10vw, 7rem);
    min-height: min(84svh, 46rem);
    display: flex;
    align-items: center;
  }

  .hero__inner {
    max-width: 46rem;
    margin: 0 auto;
    text-align: center;
  }

  .hero__headline {
    margin: 0;
    font-size: var(--text-4xl);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.015em;
  }

  .hero__accent {
    color: var(--color-noor-aqua-ink);
    font-style: italic;
  }

  .hero__subhead {
    margin: clamp(1.1rem, 3vw, 1.6rem) auto 0;
    max-width: 34rem;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--color-noor-ink-soft);
  }

  .hero__actions {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero__credentials {
    margin: clamp(1.75rem, 4vw, 2.5rem) auto 0;
    max-width: 32rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.3rem 0.65rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-noor-ink-soft);
  }

  .dot {
    color: var(--color-noor-rose-deep);
  }

  @media (min-width: 34rem) {
    .hero__actions {
      flex-direction: row;
      justify-content: center;
    }
  }

  @media (min-width: 48rem) {
    /* Wide enough for the credentials to read as the single scannable line
       the spec asks for, instead of wrapping. */
    .hero__credentials {
      max-width: none;
    }
  }
</style>
