---
import NoortureMark from './NoortureMark.astro';
import Button from './Button.astro';
import { CTA, CREDENTIALS } from '../consts';
---

<section class="hero">
  <div class="hero__inner">
    {/*
      The wordmark IS the hero, and it is set in ink with the single rose O as
      its only colour. Rendered in the pale brand aqua at this scale it read as
      decoration — a poster, not a practice. Vector, traced from the
      high-resolution artwork by `npm run build:wordmark`.
    */}
    <h1 class="hero__word">
      <NoortureMark variant="wordmark" alt="Noorture" />
    </h1>

    <p class="hero__subhead">
      Consultations, private classes, and support circles from a pediatric
      nurse practitioner and lactation consultant.
    </p>

    <div class="hero__actions">
      {/* The free 15-minute call is the lowest-friction entry point in the
          entire price list, so it sits above the fold. */}
      <Button href={CTA.primaryHref}>{CTA.primaryLabel}</Button>
      <Button href={CTA.secondaryHref} variant="secondary">
        {CTA.secondaryLabel}
      </Button>
    </div>

    <ul class="hero__credentials">
      {CREDENTIALS.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    padding: clamp(3.5rem, 10vw, 7rem) clamp(1.25rem, 5vw, 3rem)
      clamp(4rem, 10vw, 7rem);
    min-height: min(84svh, 46rem);
    display: flex;
    align-items: center;
  }

  .hero__inner {
    width: 100%;
    max-width: 60rem;
    margin: 0 auto;
    text-align: center;
  }

  .hero__word {
    margin: 0 auto;
    /* An h1 carrying artwork must not inherit display-serif line metrics. */
    line-height: 0;
    /* Dominant, but with margins — full-bleed reads shouty rather than
       confident. */
    width: min(100%, 44rem);
    --noor-wordmark-aqua: var(--color-noor-ink);
    --noor-wordmark-rose: var(--color-noor-rose-deep);
  }

  .hero__subhead {
    margin: clamp(2rem, 5vw, 3rem) auto 0;
    max-width: 36rem;
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-noor-ink-soft);
    text-wrap: balance;
  }

  .hero__actions {
    margin-top: clamp(1.75rem, 4vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  /* A rule-separated row rather than dots: it reads as a credential line on a
     letterhead instead of a string of beads. */
  .hero__credentials {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 3.5rem) auto 0;
    padding: 1.1rem 0 0;
    border-top: 1px solid var(--color-noor-line);
    max-width: 56rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.75rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-noor-ink-soft);
  }

  @media (min-width: 34rem) {
    .hero__actions {
      flex-direction: row;
      justify-content: center;
    }
  }
</style>
