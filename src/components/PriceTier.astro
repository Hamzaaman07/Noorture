---
/**
 * One purchasable tier. Prices come from PRICING in consts.ts — §2 is final,
 * and nothing on the site writes a price literal inline.
 */
interface Props {
  name: string;
  price: string;
  meta: string;
  href?: string;
  ctaLabel?: string;
  /** The one tier that should draw the eye. */
  featured?: boolean;
}
const { name, price, meta, href, ctaLabel, featured = false } = Astro.props;
---

<article class:list={['tier', featured && 'tier--featured']}>
  {featured && <p class="tier__badge">Start here</p>}
  <h3 class="tier__name">{name}</h3>
  <p class="tier__price">{price}</p>
  <p class="tier__meta">{meta}</p>
  <div class="tier__body"><slot /></div>
  {
    href && ctaLabel && (
      <p class="tier__cta">
        <a href={href} class="tap">{ctaLabel} <span aria-hidden="true">&rarr;</span></a>
      </p>
    )
  }
</article>

<style>
  .tier {
    display: flex;
    flex-direction: column;
    padding: clamp(1.35rem, 3.5vw, 1.85rem);
    background: color-mix(in srgb, #fff 64%, transparent);
    border: 1px solid var(--color-noor-line);
    border-radius: 1.15rem;
  }

  .tier--featured {
    border-color: var(--color-noor-aqua-deep);
    border-width: 2px;
    background: color-mix(in srgb, #fff 82%, transparent);
  }

  .tier__badge {
    margin: 0 0 0.75rem;
    align-self: flex-start;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--color-noor-aqua-deep);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .tier__name {
    margin: 0;
    font-size: var(--text-lg);
    font-family: var(--font-body);
    font-weight: 700;
  }

  .tier__price {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: 1;
    color: var(--color-noor-ink);
  }

  .tier__meta {
    margin: 0.5rem 0 0;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-noor-ink-soft);
  }

  .tier__body {
    margin-top: 1rem;
    flex: 1;
  }
  .tier__body :global(p) {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-noor-ink-soft);
  }

  .tier__cta {
    margin: 1.35rem 0 0;
  }
  .tier__cta a {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-noor-aqua-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-noor-aqua);
    padding-bottom: 2px;
  }
  .tier__cta a:hover {
    color: var(--color-noor-aqua-ink-hover);
  }
</style>
