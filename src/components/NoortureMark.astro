---
import { Image } from 'astro:assets';
import mark from '../assets/noorture-mark.png';
import wordmark from '../assets/noorture-wordmark-deep.png';
import lockup from '../assets/noorture-lockup.png';

/**
 * The Noorture logo.
 *
 * All three assets are generated from the client's supplied artwork by
 * `npm run build:logo` — see scripts/build-logo-assets.mjs for what that does
 * and why. Do not hand-edit the PNGs in src/assets; re-run the script.
 *
 * The source is a 408px print file, so the assets are small. That is fine at
 * the sizes used here, and every one of them is capped below its native width.
 */
interface Props {
  /**
   * 'horizontal' — mark beside wordmark. Header and footer.
   * 'stacked'    — the full vertical lockup as supplied. Give it room.
   * 'glyph'      — the mark alone.
   */
  variant?: 'horizontal' | 'stacked' | 'glyph';
  /** Rendered as decorative when a parent already names the link. */
  alt?: string;
  class?: string;
}
const {
  variant = 'horizontal',
  alt = '',
  class: className = '',
} = Astro.props;
---

{
  variant === 'stacked' ? (
    <Image
      src={lockup}
      alt={alt}
      widths={[196, 392]}
      sizes="(min-width: 48rem) 260px, 200px"
      class:list={['logo logo--stacked', className]}
      loading="eager"
    />
  ) : (
    <span class:list={['logo', `logo--${variant}`, className]}>
      <Image
        src={mark}
        alt={variant === 'glyph' ? alt : ''}
        widths={[100, 200]}
        sizes="48px"
        class="logo__mark"
        loading="eager"
      />
      {variant === 'horizontal' && (
        <Image
          src={wordmark}
          alt={alt}
          widths={[196, 392]}
          sizes="180px"
          class="logo__word"
          loading="eager"
        />
      )}
    </span>
  )
}

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo__mark {
    width: 2.6rem;
    height: auto;
    flex: none;
  }

  /*
    The deep wordmark variant — the supplied light aqua stops reading as a name
    at this size. See DEEP_BASES in scripts/build-logo-assets.mjs.
  */
  .logo__word {
    width: auto;
    height: 1.2rem;
    flex: none;
  }

  .logo--stacked {
    display: block;
    width: 12.5rem;
    height: auto;
  }

  @media (min-width: 48rem) {
    .logo__mark {
      width: 2.9rem;
    }
    .logo__word {
      height: 1.35rem;
    }
    .logo--stacked {
      width: 16rem;
    }
  }
</style>
