---
/**
 * Page section: the width, rhythm and optional tint every block shares.
 */
/*
  Note on `class`: Astro does not push a parent component's style scope onto a
  child component's root element, so a class passed in here is NOT reachable
  from the caller's scoped CSS — `.thing { ... }` in the parent silently
  matches nothing. Style your own wrapper inside the slot instead.
*/
interface Props {
  /** Pale aqua alternating tint (--noor-bg-alt), spec §6. */
  tint?: boolean;
  /** Narrow measure for long-form prose. */
  narrow?: boolean;
  id?: string;
  class?: string;
  labelledby?: string;
}
const {
  tint = false,
  narrow = false,
  id,
  class: className = '',
  labelledby,
} = Astro.props;
---

<section
  id={id}
  aria-labelledby={labelledby}
  class:list={['section', tint && 'section--tint', className]}
>
  <div class:list={['section__inner', narrow && 'section__inner--narrow']}>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: clamp(3rem, 8vw, 5.5rem);
  }

  /* The tint sits over the ambience, so it is translucent rather than solid —
     the drift still reads through it. */
  .section--tint {
    background: color-mix(in srgb, var(--color-noor-bg-alt) 72%, transparent);
    border-block: 1px solid var(--color-noor-line-alt);
  }

  .section__inner {
    max-width: 72rem;
    margin: 0 auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  .section__inner--narrow {
    max-width: 44rem;
  }
</style>
