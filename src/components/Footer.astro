---
import NoortureMark from './NoortureMark.astro';
import { NAV, SOCIAL, PODIA, SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer__brand">
      <NoortureMark />
      <p class="footer__line">
        Islamic-rooted support for the early years of parenting.
      </p>
    </div>

    <nav class="footer__col" aria-label="Footer">
      <h2>Explore</h2>
      <ul>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/gift">Gift a Circle</a></li>
      </ul>
    </nav>

    <div class="footer__col">
      <h2>Connect</h2>
      <ul>
        <li>
          <a href={SOCIAL.instagram} rel="me noopener" target="_blank">
            Instagram <span class="handle">@noorturellc</span>
          </a>
        </li>
        <li>
          <a href={SOCIAL.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
        </li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
  </div>

  <div class="footer__base">
    <div class="shell shell--base">
      <p class="footer__legal">
        &copy; {year} {SITE.name} LLC. All rights reserved.
      </p>
      <ul class="footer__legal-links">
        <li><a href="/terms">Terms</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li>
          <!-- There is no account system on this site (spec §3). This quiet
               link covers returning and past Circle members, whose accounts,
               community, and cohort archives all still live on Podia. -->
          <a href={PODIA.memberLogin} rel="noopener" target="_blank">
            Circle member login &rarr;
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(4rem, 10vw, 8rem);
    background: color-mix(in srgb, var(--color-noor-bg-alt) 86%, transparent);
    border-top: 1px solid var(--color-noor-line-alt);
  }

  .shell {
    max-width: 76rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 4vw, 2.5rem);
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .footer__line {
    margin: 0.9rem 0 0;
    max-width: 24rem;
    font-size: var(--text-sm);
    color: var(--color-noor-ink-soft);
  }

  .footer__col h2 {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-noor-ink-soft);
    margin: 0 0 0.85rem;
  }

  .footer__col ul,
  .footer__legal-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__col li + li {
    margin-top: 0.15rem;
  }

  .footer__col a {
    display: inline-block;
    padding: 0.45rem 0;
    color: var(--color-noor-ink);
    font-size: var(--text-sm);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .footer__col a:hover {
    color: var(--color-noor-aqua-ink);
    border-bottom-color: var(--color-noor-aqua);
  }

  .handle {
    color: var(--color-noor-ink-soft);
  }

  .footer__base {
    border-top: 1px solid var(--color-noor-line-alt);
  }

  .shell--base {
    padding-block: 1.25rem;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    align-items: center;
  }

  .footer__legal {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-noor-ink-soft);
  }

  .footer__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
  }
  .footer__legal-links a {
    display: inline-block;
    padding: 0.35rem 0;
    font-size: var(--text-xs);
    color: var(--color-noor-ink-soft);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .footer__legal-links a:hover {
    color: var(--color-noor-aqua-ink);
    border-bottom-color: var(--color-noor-aqua);
  }

  @media (min-width: 48rem) {
    .shell {
      grid-template-columns: 1.5fr 1fr 1fr;
    }
    .shell--base {
      grid-template-columns: 1fr auto;
    }
  }
</style>
