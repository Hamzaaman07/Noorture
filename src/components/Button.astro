---
/**
 * Sea-glass buttons.
 *
 * A tinted, frosted pane rather than a filled shape with a drawn outline: a
 * translucent brand colour over a blurred backdrop, a light catch along the top
 * edge, a soft rim where the glass thickens at the bottom, and a coloured
 * shadow so it lifts off the page. There is no `border` — the "hard edge" is
 * gone.
 *
 * On contrast, because it constrains the whole design. An ink label needs the
 * fill to be light (>= L 0.444 to hold 4.5:1), while a fill dark enough to be
 * its own 3:1 boundary against this near-white page needs L <= 0.276. Those
 * cannot both be true, so the edge has to come from somewhere. Here it is the
 * bottom rim and the drop shadow rather than a stroke — measured, not assumed:
 * scripts/check-contrast.mjs reports the darkest rendered edge pixel.
 *
 * Fills are kept at 0.9 alpha — "more opaque", and enough that the label's
 * contrast barely moves with whatever the ambience is doing behind it.
 */
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}
const { href, variant = 'primary', class: className = '' } = Astro.props;
---

<a href={href} class:list={['btn', `btn--${variant}`, className]}>
  <span><slot /></span>
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    /* Comfortably past the 44px touch target — she is holding a baby. */
    min-height: 3.25rem;
    padding: 0.9rem 1.9rem;
    border: 0;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    color: var(--color-noor-ink);
    /* Frosts whatever the ambience is doing behind the glass. */
    backdrop-filter: blur(10px) saturate(1.35);
    -webkit-backdrop-filter: blur(10px) saturate(1.35);
    transition:
      background-color 240ms var(--ease-noor),
      box-shadow 240ms var(--ease-noor),
      transform 240ms var(--ease-noor);
  }

  /*
    Frosted, not glossy. The first pass used a tight specular highlight and a
    hard bottom bevel, which read as glossy plastic — sea glass is tumbled
    matte, so the light across it is broad and diffuse, and the "thickness" is
    a soft rim running the whole way round rather than a lip along the bottom.
    The milky wash is what stops the fill reading as flat paint.
  */
  .btn--primary {
    background-image:
      linear-gradient(
        160deg,
        rgba(255, 255, 255, 0.42) 0%,
        rgba(255, 255, 255, 0.1) 46%,
        rgba(255, 255, 255, 0.16) 100%
      );
    background-color: color-mix(
      in srgb,
      var(--color-noor-rose-bright) 90%,
      transparent
    );
    box-shadow:
      /* diffuse light across the top face */
      inset 0 6px 14px -6px rgba(255, 255, 255, 0.9),
      /* The glass has thickness. This rim is also what makes the control's
         boundary perceivable now that there is no border: blurred over 4px so
         it reads as shading rather than a stroke, but deep enough that its
         darkest pixel measures 3.2:1 against the page — WCAG asks 3:1 for a
         component's edge, and the soft first attempt only reached 1.8:1.
         scripts/check-contrast.mjs measures it on the rendered button. */
      inset 0 0 4px 1px rgba(120, 42, 78, 0.86),
      inset 0 -12px 18px -12px rgba(150, 62, 100, 0.5),
      /* sits on the page rather than floating above it */
      0 2px 10px -4px rgba(180, 84, 128, 0.3),
      0 14px 28px -18px rgba(180, 84, 128, 0.55);
  }
  .btn--primary:hover {
    background-color: var(--color-noor-rose-bright);
    box-shadow:
      inset 0 6px 14px -6px rgba(255, 255, 255, 1),
      inset 0 0 4px 1px rgba(120, 42, 78, 0.9),
      inset 0 -12px 18px -12px rgba(150, 62, 100, 0.55),
      0 3px 12px -4px rgba(180, 84, 128, 0.36),
      0 18px 34px -18px rgba(180, 84, 128, 0.6);
    transform: translateY(-1px);
  }

  .btn--secondary {
    background-image:
      linear-gradient(
        160deg,
        rgba(255, 255, 255, 0.46) 0%,
        rgba(255, 255, 255, 0.12) 46%,
        rgba(255, 255, 255, 0.18) 100%
      );
    background-color: color-mix(
      in srgb,
      var(--color-noor-aqua) 86%,
      transparent
    );
    box-shadow:
      inset 0 6px 14px -6px rgba(255, 255, 255, 0.95),
      inset 0 0 4px 1px rgba(14, 68, 72, 0.86),
      inset 0 -12px 18px -12px rgba(31, 105, 110, 0.45),
      0 2px 10px -4px rgba(45, 130, 136, 0.28),
      0 14px 28px -18px rgba(45, 130, 136, 0.5);
  }
  .btn--secondary:hover {
    background-color: var(--color-noor-aqua);
    box-shadow:
      inset 0 6px 14px -6px rgba(255, 255, 255, 1),
      inset 0 0 4px 1px rgba(14, 68, 72, 0.9),
      inset 0 -12px 18px -12px rgba(31, 105, 110, 0.5),
      0 3px 12px -4px rgba(45, 130, 136, 0.34),
      0 18px 34px -18px rgba(45, 130, 136, 0.55);
    transform: translateY(-1px);
  }

  .btn:active {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
    .btn:hover {
      transform: none;
    }
  }
</style>
